#!/bin/bash
# ---------------------------------------------------------------------------
# Install these dotfiles into the current user's home.
#
# Safe to run repeatedly: links that are already correct are left alone,
# stale or dangling links are replaced, and real files that are in the way
# are moved aside to "<name>.bak.<timestamp>" instead of being overwritten.
#
# Usage: install [-c] [-n] [-h]   (see usage below)
# ---------------------------------------------------------------------------

set -uo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly DOTFILES
BACKUP_SUFFIX=".bak.$(date +%Y%m%d%H%M%S)"
readonly BACKUP_SUFFIX
readonly OH_MY_ZSH_URL="https://github.com/exhuma/oh-my-zsh.git"
readonly OH_MY_ZSH_UPSTREAM="ssh://git@github.com/robbyrussell/oh-my-zsh"
readonly TMUX_THEMEPACK_URL="https://github.com/jimeh/tmux-themepack.git"
readonly CLEANUP_TIMER="systemd-tmpfiles-clean.timer"

DRY_RUN=0
FAILURES=0

# --- output ----------------------------------------------------------------

info() { printf '%s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*" >&2; }

# Report an error and remember it for the exit status.
error() {
    printf '[error] %s\n' "$*" >&2
    FAILURES=$((FAILURES + 1))
}

# Run a command that changes the system; only print it in dry-run mode.
# Returns the command's exit status and records failures.
run() {
    if ((DRY_RUN)); then
        info "[dry] $*"
        return 0
    fi
    "$@" || {
        local status=$?
        error "command failed (${status}): $*"
        return "${status}"
    }
}

# --- helpers ---------------------------------------------------------------

# Make DST a symlink to SRC (a path relative to the dotfiles repo).
# Arguments:
#   $1 - source, relative to DOTFILES
#   $2 - destination (absolute path)
link() {
    local src="${DOTFILES}/$1"
    local dst="$2"
    local current

    if [[ ! -e "${src}" ]]; then
        warn "missing source, not linking: ${src}"
        return 0
    fi
    if [[ -L "${dst}" ]]; then
        current="$(readlink -f -- "${dst}")"
        if [[ "${current}" == "$(readlink -f -- "${src}")" ]]; then
            info "[ok] ${dst}"
            return 0
        fi
        run rm -- "${dst}" || return
    elif [[ -e "${dst}" ]]; then
        info "[backup] ${dst} -> ${dst}${BACKUP_SUFFIX}"
        run mv -- "${dst}" "${dst}${BACKUP_SUFFIX}" || return
    fi
    if [[ ! -d "$(dirname -- "${dst}")" ]]; then
        run mkdir -p -- "$(dirname -- "${dst}")" || return
    fi
    info "[link] ${dst} -> ${src}"
    run ln -s -- "${src}" "${dst}"
}

# --- steps -----------------------------------------------------------------

link_dotfiles() {
    local f
    for f in .psqlrc .irssi .bashrc .bashrc_BBS-goon .digrc .gitconfig \
        .inputrc .pylintrc .Xmodmap .pystartup .tmux.conf .Xresources \
        .zshrc .zshrc_blackdragon .zshrc_lillend .minttyrc .xinitrc .i3; do
        link "${f}" "${HOME}/${f}"
    done
    link .gitignore_global "${HOME}/.gitignore"
    link .stignore "${HOME}/.stignore"
    link .Xresources "${HOME}/.Xdefaults"

    for f in bspwm rofi fish sxhkd nvim; do
        link "${f}" "${HOME}/.config/${f}"
    done
    link i3status.config "${HOME}/.config/i3status/config"
    link .config/fontconfig/conf.d/99-emoji.conf \
        "${HOME}/.config/fontconfig/conf.d/99-emoji.conf"
    link .config/user-tmpfiles.d/prune.conf \
        "${HOME}/.config/user-tmpfiles.d/prune.conf"
    link .config/systemd/user/${CLEANUP_TIMER}.d/persistent.conf \
        "${HOME}/.config/systemd/user/${CLEANUP_TIMER}.d/persistent.conf"

    for f in DESKTOP-BHQ0QLD basilisk displacer2 turian legion; do
        link "zsh-perhost/${f}.zsh" "${HOME}/.zsh/perhost/${f}.zsh"
    done

    link claude-skills/vikunja "${HOME}/.claude/skills/vikunja"
    link VsCode/settings.json "${HOME}/.config/Code/User/settings.json"
    link VsCode/michel-albert-theme \
        "${HOME}/.vscode/extensions/exhuma.michel-albert-theme-0.1.0"
}

# ~/.gnupg may be a link to the whole repo folder (which then also holds the
# untracked keys); leave that alone. Otherwise link only tracked config.
setup_gnupg() {
    if [[ -L "${HOME}/.gnupg" ]]; then
        info "[skip] ${HOME}/.gnupg is a symlink, leaving it alone"
        return 0
    fi
    if [[ ! -d "${HOME}/.gnupg" ]]; then
        run mkdir -p -- "${HOME}/.gnupg" || return
    fi
    run chmod 700 -- "${HOME}/.gnupg" || return
    link .gnupg/gpg-agent.conf "${HOME}/.gnupg/gpg-agent.conf"
}

# ~/.psql_history used to be a single file; it is now a folder (see .psqlrc).
setup_psql_history() {
    local dir="${HOME}/.psql_history"
    if [[ -f "${dir}" ]]; then
        info "[migrate] ${dir} file -> ${dir}/old-single-file-history"
        run mv -- "${dir}" "${dir}${BACKUP_SUFFIX}" || return
        run mkdir -p -- "${dir}" || return
        run mv -- "${dir}${BACKUP_SUFFIX}" "${dir}/old-single-file-history"
        return
    fi
    if [[ -d "${dir}" ]]; then
        info "[ok] ${dir}"
        return 0
    fi
    run mkdir -p -- "${dir}"
}

install_tools() {
    if command -v cstop >/dev/null; then
        info "[ok] cstop"
    elif command -v pipx >/dev/null; then
        run pipx install cstop
    else
        warn "pipx not found, skipping cstop"
    fi
}

setup_oh_my_zsh() {
    local dir="${HOME}/.oh-my-zsh"
    if [[ -d "${dir}/.git" ]]; then
        info "[ok] ${dir}"
    else
        run git clone -q "${OH_MY_ZSH_URL}" "${dir}" || return
    fi
    if ((DRY_RUN)) && [[ ! -d "${dir}/.git" ]]; then
        return 0
    fi
    if git -C "${dir}" remote get-url upstream >/dev/null 2>&1; then
        info "[ok] ${dir} remote upstream"
    else
        run git -C "${dir}" remote add upstream "${OH_MY_ZSH_UPSTREAM}"
    fi
}

setup_tmux_themepack() {
    local dir="${HOME}/.tmux-themepack"
    if [[ -d "${dir}/.git" ]]; then
        info "[update] ${dir}"
        run git -C "${dir}" pull -q --ff-only
    else
        run git clone -q "${TMUX_THEMEPACK_URL}" "${dir}"
    fi
}

# Render the irssi config from its template. Needs a terminal for the
# password prompt and never overwrites an existing config.
setup_irssi() {
    local config="${HOME}/.irssi/config"
    local password
    if ! command -v irssi >/dev/null; then
        info "[skip] irssi not installed"
    elif [[ -e "${config}" ]]; then
        info "[ok] ${config}"
    elif [[ ! -t 0 ]]; then
        warn "no terminal for the irssi password prompt, skipping ${config}"
    elif ((DRY_RUN)); then
        info "[dry] render ${config} from template"
    else
        read -rsp "[IRSSI] FreeNode Password: " password
        echo
        sed -e "s/{{password}}/${password}/" \
            "${DOTFILES}/.irssi/config.template" >"${config}" ||
            error "could not write ${config}"
    fi
}

setup_host_overlay() {
    local host
    host="$(hostname -s)"
    if [[ -d "${DOTFILES}/${host}/.kde/Autostart" ]]; then
        link "${host}/.kde/Autostart" "${HOME}/.kde/Autostart"
    fi
    if [[ -f "${DOTFILES}/${host}/.xmodmaprc" ]]; then
        link "${host}/.xmodmaprc" "${HOME}/.xmodmaprc"
    fi
}

# Daily age-based cleanup of ~/Downloads and ~/tmp (systemd-tmpfiles --user).
setup_cleanup_timer() {
    if ! command -v systemctl >/dev/null ||
        ! systemctl --user show-environment >/dev/null 2>&1; then
        warn "no systemd user manager, skipping ${CLEANUP_TIMER}"
        return 0
    fi
    run systemctl --user daemon-reload || return
    if systemctl --user is-enabled -q "${CLEANUP_TIMER}" 2>/dev/null; then
        info "[ok] ${CLEANUP_TIMER} enabled"
    else
        run systemctl --user enable --now "${CLEANUP_TIMER}"
    fi
}

# Windows VS Code does not follow Cygwin symlinks, so copy instead.
setup_cygwin() {
    [[ "$(uname -s)" == CYGWIN* ]] || return 0
    local userprofile="${USERPROFILE:?USERPROFILE not set}"
    local ext="${userprofile}/.vscode/extensions"
    run mkdir -p -- "${userprofile}/AppData/Roaming/Code/User" "${ext}" ||
        return
    run cp -- "${DOTFILES}/VsCode/settings.json" \
        "${userprofile}/AppData/Roaming/Code/User/settings.json"
    run cp -r -- "${DOTFILES}/VsCode/michel-albert-theme" \
        "${ext}/exhuma.michel-albert-theme-0.1.0"
}

# Remove state that a fresh clone/link should replace. Links themselves need
# no cleaning: link() repairs them.
clean_install() {
    info "[clean] removing ${HOME}/.oh-my-zsh"
    run rm -rf -- "${HOME}/.oh-my-zsh"
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [-c] [-n] [-h]

Install the dotfiles from ${DOTFILES} into ${HOME}.

  -c            clean install: re-clone oh-my-zsh (no prompt)
  -n, --dry-run show what would change without changing anything
  -h, --help    show this help

Without -c, asks whether to do a clean install if run from a terminal.
EOF
}

main() {
    local clean=""
    local answer
    while (($#)); do
        case "$1" in
            -c) clean=y ;;
            -n | --dry-run) DRY_RUN=1 ;;
            -h | --help) usage; return 0 ;;
            *) usage >&2; return 2 ;;
        esac
        shift
    done
    if [[ -z "${clean}" && -t 0 ]]; then
        read -rp "Perform clean install? [y/N] " answer
        [[ "${answer}" == [yY] ]] && clean=y
    fi

    [[ "${clean}" == y ]] && clean_install
    link_dotfiles
    setup_gnupg
    setup_psql_history
    setup_host_overlay
    setup_cleanup_timer
    setup_cygwin
    install_tools
    setup_oh_my_zsh
    setup_tmux_themepack
    setup_irssi

    if ((FAILURES)); then
        error "finished with ${FAILURES} failure(s)"
        return 1
    fi
    info "done!"
}

main "$@"
