{
  "Pretty Print": {
    "prefix": "pp",
    "body": "from pprint import pformat; print('\\u001b[30;43m[debug-print-$RANDOM_HEX]\\u001b[0m\\n%s' % pformat(${1}))  # XXX debug statement",
    "description": "Pretty Print"
  },
  "Debug Print": {
    "prefix": "dp",
    "body": "print('\\u001b[30;43m[debug-print-$RANDOM_HEX]\\u001b[0m', ${1})  # XXX debug statement",
    "description": "Debug Print"
  },
  "Repr Print": {
    "prefix": "rp",
    "body": "print('\\u001b[30;43m[debug-print-$RANDOM_HEX]\\u001b[0m', repr(${1}))  # XXX debug statement",
    "description": "Repr Print"
  },
  "Inline debugger": {
    "prefix": "pdb",
    "body": "from pdb import set_trace; set_trace()  # XXX debugger",
    "description": "Inline debugger"
  },
  "Inline debugger (ipython)": {
    "prefix": "ipdb",
    "body": "from ipdb import set_trace; set_trace()  # XXX debugger",
    "description": "Inline debugger (ipython)"
  },
  "Simple Setup": {
    "prefix": "setup",
    "body": [
      "from setuptools import setup, find_packages",
      "from pkg_resources import resource_string",
      "setup(",
      "    name=\"${1:name}\",",
      "    version=resource_string('$1', 'version.txt').strip(),",
      "    packages=find_packages(),",
      "    install_requires=[",
      "        '${2:config_resolver}',",
      "    ],",
      "    include_package_data=True,",
      "    author=\"${3:Michel Albert}\",",
      "    author_email=\"${4:jdoe@example.com}\",",
      "    description=\"${5:Description}\",",
      "    license=\"${6:BSD}\",",
      "    url=\"${7:https://github.com/exhuma}\",",
      ")"
    ],
    "description": "Simple Setup"
  },
  "Module logger": {
    "prefix": "logger",
    "body": "LOG = logging.getLogger(__name__)",
    "description": "Module logger"
  },
  "Protected main block": {
    "prefix": "ifmain",
    "body": [
      "if __name__ == '__main__':",
      "    $0"
    ],
    "description": "Protected main block"
  },
  "Dunder": {
    "prefix": "__",
    "body": "__${1}__",
    "description": "Dunder"
  },
  "Unittest": {
    "prefix": "ut",
    "body": [
      "import unittest",
      "",
      "",
      "class Test${1}(${2:unittest.TestCase}):",
      "",
      "    def test_${3}(self):",
      "        $4"
    ],
    "description": "Unittest"
  },
  "skipTest(TODO)": {
    "prefix": "skip",
    "body": "self.skipTest('TODO')  # XXX",
    "description": "skipTest(TODO)"
  },
  "fail('TODO')": {
    "prefix": "fail",
    "body": "self.fail('TODO')  # XXX",
    "description": "fail('TODO')"
  },
  "Reveal Type": {
    "prefix": "rt",
    "body": "reveal_type(${1})",
    "description": "Reveal Type"
  }
}
