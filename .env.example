# Copy this file to .env (gitignored) and fill in real values.
# Sourced from .zshrc so `vk` and the "vikunja" Claude Code skill work in
# every new shell without exporting these by hand.

export VIKUNJA_URL="https://your-vikunja-instance.example.com"
export VIKUNJA_TOKEN="your-personal-api-token"
# export VIKUNJA_OWNER="yourusername"   # optional, defaults to "exhuma"
